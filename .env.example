# Local MongoDB connection settings
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=tech_news

# Create a GNews account and put your real key only in your local .env.
GNEWS_API_KEY=replace_with_your_gnews_api_key
GNEWS_API_URL=https://gnews.io/api/v4/search
GNEWS_QUERY=technology OR "artificial intelligence" OR cybersecurity OR "cloud computing" OR "quantum computing" OR "developer tools" OR startup

# Daily collection and briefing time (24-hour clock)
NEWS_SCHEDULE_HOUR=6
NEWS_SCHEDULE_MINUTE=0
NEWS_SCHEDULE_TIMEZONE=Asia/Kolkata
